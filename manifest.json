{
  "manifest_version": 2,
  "name": "Gemini Monet — Material You",
  "version": "1.0.0",
  "description": "Full Material You (Monet) dynamic theming and native M3 styling for Gemini Web.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "theme",
    "https://gemini.google.com/*",
    "https://ogs.google.com/*"
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Gemini Monet Settings",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": [
      "material-color.js",
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://ogs.google.com/*"
      ],
      "js": ["content.js"],
      "css": ["inject.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    "theme-map.json"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "gemini-monet-web@aizen",
      "strict_min_version": "100.0"
    }
  }
}
